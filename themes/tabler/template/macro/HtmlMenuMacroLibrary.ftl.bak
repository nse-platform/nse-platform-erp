<#-- ============================================================
     renderMenuBegin
     菜单容器开标签。
     - id / style 二选一（保持原有逻辑，避免部分主题双用时崩溃）
     - title 渲染为 .nav-header 小标题
     - 外层 <div> + <ul class="navbar-nav"> 对应 Tabler 侧边栏导航
     ============================================================ -->
<#macro renderMenuBegin boundaryComment="" id="" style="" title="">
    <#if boundaryComment?has_content><!-- ${boundaryComment} --></#if>
<div<#if id?has_content> id="${id}"<#elseif style?has_content> class="${style}"</#if>>
    <#if title?has_content><div class="nav-header">${title}</div></#if>
    <ul class="navbar-nav">
        </#macro>

        <#-- ============================================================
             renderMenuEnd
             菜单容器关标签。
             ============================================================ -->
        <#macro renderMenuEnd boundaryComment="">
    </ul>
</div>
    <#if boundaryComment?has_content><!-- ${boundaryComment} --></#if>
</#macro>

<#-- ============================================================
     renderImage
     菜单内图片，补充 img-fluid 响应式类。
     border 改为 inline style 避免 HTML5 废弃属性警告。
     ============================================================ -->
<#macro renderImage src id style width height border>
    <img src="${src}"<#if id?has_content> id="${id}"</#if>
         class="img-fluid<#if style?has_content> ${style}</#if>"
            <#if width?has_content> width="${width}"</#if>
            <#if height?has_content> height="${height}"</#if>
            <#if border?has_content> style="border:${border}px solid transparent"</#if>/>
</#macro>

<#-- ============================================================
     renderLink
     菜单链接，支持三种 linkType：
       hidden-form   → 隐藏表单 POST 提交
       layered-modal → Tabler Modal 弹窗
       update-area   → AJAX 局部刷新
       (默认)        → 普通链接
     ============================================================ -->
<#macro renderLink linkUrl parameterList targetWindow uniqueItemName actionUrl confirmation="" linkType="" id="" style="" name="" height="600" width="800" text="" imgStr="">
    <#if linkType?has_content && "hidden-form" == linkType>
        <form method="post" action="${actionUrl}"<#if targetWindow?has_content> target="${targetWindow}"</#if> onsubmit="javascript:submitFormDisableSubmits(this)" name="${uniqueItemName}" class="d-none">
            <#list parameterList as parameter>
                <input name="${parameter.name}" value="${parameter.value?html}" type="hidden"/>
            </#list>
        </form>
    </#if>
    <#if uniqueItemName?has_content && "layered-modal" == linkType>
        <#local params = "{&quot;presentation&quot;:&quot;layer&quot;">
        <#if parameterList?has_content>
            <#list parameterList as parameter>
                <#local params += ",&quot;${parameter.name}&quot;:&quot;${parameter.value?html}&quot;">
            </#list>
        </#if>
        <#local params += "}">
        <a href="javascript:void(0);"
           id="${uniqueItemName}_link"
           data-dialog-params="${params}"
           data-dialog-width="${width}"
           data-dialog-height="${height}"
           data-dialog-url="${linkUrl}"
           <#if text?has_content>data-dialog-title="${text}"</#if>
           class="nav-link<#if style?has_content> ${style}</#if>">
            <#if imgStr?has_content>${imgStr}</#if>
            <#if text?has_content><span class="nav-link-title">${text}</span></#if>
        </a>
    <#else>
        <#if (linkType?has_content && "hidden-form" == linkType) || linkUrl?has_content>
            <a<#if id?has_content> id="${id}"</#if>
            class="nav-link<#if style?has_content> ${style}</#if>"
            <#if name?has_content> name="${name}"</#if>
            <#if targetWindow?has_content && "update-area" != linkType> target="${targetWindow}"</#if>
            <#if confirmation?has_content> onclick="return confirm('${confirmation?js_string}');"</#if>
            href="<#if "hidden-form" == linkType><#if linkUrl?has_content>javascript:ajaxSubmitFormUpdateAreas('${uniqueItemName}', '${linkUrl}')<#else>javascript:document.${uniqueItemName}.submit()</#if><#elseif "update-area" == linkType>javascript:ajaxUpdateAreas('${linkUrl}')<#else>${linkUrl}</#if>">
        </#if>
        <#if imgStr?has_content>${imgStr}</#if><#if text?has_content><span class="nav-link-title">${text}</span></#if>
        <#if (linkType?has_content && "hidden-form" == linkType) || linkUrl?has_content></a></#if>
    </#if>
</#macro>

<#-- ============================================================
     renderMenuItemBegin
     菜单项开标签 → Tabler .nav-item
     - 有子菜单（containsNestedMenus）时添加 .dropdown 类
       并输出子菜单 <ul class="dropdown-menu">
     - toolTip 通过 title + data-bs-toggle="tooltip" 呈现
     ============================================================ -->
<#macro renderMenuItemBegin style="" toolTip="" linkStr="" containsNestedMenus=false>
<li class="nav-item<#if containsNestedMenus> dropdown</#if><#if style?has_content> ${style}</#if>"<#if toolTip?has_content> title="${toolTip}" data-bs-toggle="tooltip"</#if>>
    <#if linkStr?has_content>${linkStr}</#if>
    <#if containsNestedMenus><ul class="dropdown-menu"></#if>
        </#macro>

        <#-- ============================================================
             renderMenuItemEnd
             菜单项关标签
             ============================================================ -->
        <#macro renderMenuItemEnd containsNestedMenus=false>
        <#if containsNestedMenus></ul></#if>
</li>
</#macro>
